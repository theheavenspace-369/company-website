# Block access to all files by default
<FilesMatch ".*">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow only the public form-handling endpoints
<FilesMatch "^(sendemail|save-contact)\.php$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Deny access to .env file
<FilesMatch "^\.env$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to app, template and data folders
RewriteEngine On
RewriteRule ^app/.*$ - [F,L]
RewriteRule ^template/.*$ - [F,L]
RewriteRule ^data/.*$ - [F,L]
ErrorDocument 403 <h1>403-Forbidden-:(</h1>
